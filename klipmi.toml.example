[klipmi]
device = "/dev/ttyS1"
baudrate = 115200
ui = "openq1"

[moonraker]
host = "0.0.0.0"
port = 7125
api-key = "xxxxxxxxxxxxxxxxxxx"

# QIDI Plus 4 (replaces the FreeDi/stock screen service; stop it first):
#
# [klipmi]
# device = "/dev/ttyS1"
# baudrate = 115200 # the speed the screen boots at on other firmware; plus4canvas switches to 921600 by itself
# ui = "plus4canvas" # "plus4" drives QIDI's stock HMI instead (older, fewer features)
# mmu = "auto"      # "auto": MMU pages only if Happy Hare is configured; "off": never
#
# [moonraker]
# host = "127.0.0.1"
# port = 7125
